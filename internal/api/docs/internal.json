{
  "openapi": "3.0.3",
  "info": {
    "title": "Warden Internal API",
    "description": "Session-cookie authenticated API for the Warden web UI. All endpoints (except auth) require a valid `warden_session` cookie obtained via `/auth/local`, `/auth/magic`, or the OIDC flow.",
    "version": "1.0.0"
  },
  "servers": [{"url": "/api/v1/internal", "description": "Internal API"}],
  "security": [{"sessionCookie": []}],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "warden_session",
        "description": "Session cookie set after successful login"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}}
      },
      "Hold": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "released", "expired"]},
          "placed_by": {"type": "string", "format": "uuid"},
          "placed_by_name": {"type": "string"},
          "template_id": {"type": "string", "format": "uuid"},
          "expires_at": {"type": "string", "format": "date-time"},
          "released_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "HoldEnriched": {
        "allOf": [{"$ref": "#/components/schemas/Hold"}],
        "properties": {
          "custodians": {"type": "array", "items": {"$ref": "#/components/schemas/Custodian"}},
          "cascade_states": {"type": "array", "items": {"$ref": "#/components/schemas/CascadeState"}}
        }
      },
      "Custodian": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "hold_id": {"type": "string", "format": "uuid"},
          "email": {"type": "string", "format": "email"},
          "added_by": {"type": "string", "format": "uuid"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "CascadeState": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "hold_id": {"type": "string", "format": "uuid"},
          "custodian_email": {"type": "string", "format": "email"},
          "instance_id": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["pending", "in_progress", "completed", "partial", "failed"]},
          "last_error": {"type": "string"},
          "attempts": {"type": "integer"},
          "completed_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "HoldTemplate": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "provider_glob": {"type": "string", "example": "*"},
          "blocked_actions": {"type": "array", "items": {"type": "string"}},
          "notes_template": {"type": "string"},
          "expiration_days": {"type": "integer"},
          "is_default": {"type": "boolean"},
          "created_by": {"type": "string", "format": "uuid"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "aggregate_type": {"type": "string"},
          "aggregate_id": {"type": "string", "format": "uuid"},
          "version": {"type": "integer"},
          "type": {"type": "string"},
          "actor_id": {"type": "string", "format": "uuid"},
          "actor_type": {"type": "string"},
          "actor_display": {"type": "string"},
          "payload": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Approval": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "action_key": {"type": "string"},
          "instance_id": {"type": "string", "format": "uuid"},
          "target_email": {"type": "string"},
          "requested_by": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "approved", "rejected", "expired"]},
          "review_note": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time"},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "is_builtin": {"type": "boolean"},
          "permissions": {"type": "array", "items": {"type": "string"}}
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "email": {"type": "string", "format": "email"},
          "name": {"type": "string"},
          "is_active": {"type": "boolean"},
          "origin": {"type": "string", "enum": ["local", "oidc", "scim"]},
          "roles": {"type": "array", "items": {"type": "string"}},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Instance": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "plugin_id": {"type": "string"},
          "is_active": {"type": "boolean"},
          "last_health_ok": {"type": "boolean"},
          "last_health_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "scopes": {"type": "array", "items": {"type": "string"}},
          "last_used": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "PBACPolicy": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "policy_type": {"type": "string"},
          "is_enabled": {"type": "boolean"},
          "config": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get current user",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "Current session user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {"$ref": "#/components/schemas/User"}
                  }
                }
              }
            }
          },
          "401": {"description": "Not authenticated"}
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "oidcLogin",
        "summary": "Initiate OIDC login",
        "description": "Redirects to the configured OIDC provider. Requires SSO to be configured.",
        "tags": ["Auth"],
        "security": [],
        "responses": {
          "302": {"description": "Redirect to OIDC authorization endpoint"},
          "501": {"description": "SSO not configured"}
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Log out",
        "tags": ["Auth"],
        "responses": {
          "200": {"description": "Session cleared"},
          "401": {"description": "Not authenticated"}
        }
      }
    },
    "/holds/": {
      "get": {
        "operationId": "listHolds",
        "summary": "List legal holds (enriched)",
        "description": "Returns all holds with their custodians and cascade states. Required permission: holds:read.",
        "tags": ["Holds"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {"type": "string", "enum": ["active", "released", "expired"]},
            "description": "Filter by status"
          }
        ],
        "responses": {
          "200": {
            "description": "Holds with enriched data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holds": {"type": "array", "items": {"$ref": "#/components/schemas/HoldEnriched"}}
                  }
                }
              }
            }
          },
          "401": {"description": "Not authenticated"},
          "403": {"description": "Insufficient permission"}
        }
      },
      "post": {
        "operationId": "createHold",
        "summary": "Create a legal hold",
        "tags": ["Holds"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "description": {"type": "string"},
                  "template_id": {"type": "string", "format": "uuid"},
                  "expires_at": {"type": "string", "format": "date-time"},
                  "custodian_emails": {"type": "array", "items": {"type": "string", "format": "email"}}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hold created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hold": {"$ref": "#/components/schemas/Hold"},
                    "failed_custodians": {"type": "array", "items": {"type": "string"}},
                    "warning": {"type": "string"}
                  }
                }
              }
            }
          },
          "400": {"description": "Invalid request"},
          "403": {"description": "Insufficient permission"}
        }
      }
    },
    "/holds/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {
        "operationId": "getHold",
        "summary": "Get a single hold with custodians and cascade states",
        "tags": ["Holds"],
        "responses": {
          "200": {
            "description": "Hold detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hold": {"$ref": "#/components/schemas/Hold"},
                    "placed_by_name": {"type": "string"},
                    "custodians": {"type": "array", "items": {"$ref": "#/components/schemas/Custodian"}},
                    "cascade_states": {"type": "array", "items": {"$ref": "#/components/schemas/CascadeState"}}
                  }
                }
              }
            }
          },
          "404": {"description": "Not found"}
        }
      }
    },
    "/holds/{id}/custodians": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "addCustodian",
        "summary": "Add a custodian to a hold",
        "tags": ["Holds"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {"email": {"type": "string", "format": "email"}}
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Custodian added"},
          "400": {"description": "Invalid email or hold not active"},
          "403": {"description": "Insufficient permission"},
          "404": {"description": "Hold not found"}
        }
      }
    },
    "/holds/{id}/custodians/{custodianId}": {
      "parameters": [
        {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
        {"name": "custodianId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
      ],
      "delete": {
        "operationId": "removeCustodian",
        "summary": "Remove a custodian from a hold",
        "tags": ["Holds"],
        "responses": {
          "200": {"description": "Custodian removed"},
          "403": {"description": "Insufficient permission"},
          "404": {"description": "Hold or custodian not found"}
        }
      }
    },
    "/holds/{id}/release": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "releaseHold",
        "summary": "Release a legal hold",
        "tags": ["Holds"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {"reason": {"type": "string"}}
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Hold released"},
          "400": {"description": "Hold not active or reason missing"},
          "403": {"description": "Insufficient permission"},
          "404": {"description": "Hold not found"}
        }
      }
    },
    "/audit/events": {
      "get": {
        "operationId": "listAuditEvents",
        "summary": "Query audit events",
        "tags": ["Audit"],
        "parameters": [
          {"name": "aggregate_type", "in": "query", "schema": {"type": "string"}},
          {"name": "aggregate_id", "in": "query", "schema": {"type": "string", "format": "uuid"}},
          {"name": "since", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100}}
        ],
        "responses": {
          "200": {
            "description": "Audit events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {"type": "array", "items": {"$ref": "#/components/schemas/AuditEvent"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/audit/export": {
      "get": {
        "operationId": "exportAuditEvents",
        "summary": "Export audit events",
        "tags": ["Audit"],
        "parameters": [
          {"name": "format", "in": "query", "schema": {"type": "string", "enum": ["json", "csv"], "default": "csv"}}
        ],
        "responses": {
          "200": {
            "description": "Audit log download",
            "content": {
              "text/csv": {"schema": {"type": "string"}},
              "application/json": {"schema": {"type": "object"}}
            }
          }
        }
      }
    },
    "/approvals/": {
      "get": {
        "operationId": "listApprovals",
        "summary": "List pending approval requests",
        "tags": ["Approvals"],
        "responses": {
          "200": {
            "description": "Pending approvals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approvals": {"type": "array", "items": {"$ref": "#/components/schemas/Approval"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/approvals/{id}/approve": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "approveRequest",
        "summary": "Approve a pending request",
        "description": "Approvers cannot approve their own requests.",
        "tags": ["Approvals"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"type": "object", "properties": {"note": {"type": "string"}}}
            }
          }
        },
        "responses": {
          "200": {"description": "Approved"},
          "403": {"description": "Insufficient permission"},
          "409": {"description": "Already decided or self-approval not permitted"}
        }
      }
    },
    "/approvals/{id}/reject": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "rejectRequest",
        "summary": "Reject a pending request",
        "tags": ["Approvals"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"type": "object", "properties": {"note": {"type": "string"}}}
            }
          }
        },
        "responses": {
          "200": {"description": "Rejected"},
          "403": {"description": "Insufficient permission"},
          "409": {"description": "Already decided"}
        }
      }
    },
    "/actions/": {
      "get": {
        "operationId": "listActions",
        "summary": "List available integration actions",
        "tags": ["Actions"],
        "responses": {
          "200": {"description": "Actions list"}
        }
      }
    },
    "/actions/execute": {
      "post": {
        "operationId": "executeAction",
        "summary": "Execute an integration action",
        "tags": ["Actions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action_key", "target_email"],
                "properties": {
                  "action_key": {"type": "string"},
                  "instance_id": {"type": "string", "format": "uuid"},
                  "target_email": {"type": "string", "format": "email"},
                  "params": {"type": "object"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Action executed"},
          "202": {"description": "Queued for approval"},
          "400": {"description": "Invalid request"},
          "403": {"description": "Blocked by PBAC policy"}
        }
      }
    },
    "/identities/search": {
      "get": {
        "operationId": "searchIdentities",
        "summary": "Search identity directory",
        "tags": ["Identities"],
        "parameters": [
          {"name": "q", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20}}
        ],
        "responses": {
          "200": {"description": "Matching identities"}
        }
      }
    },
    "/identities/cache/refresh": {
      "post": {
        "operationId": "refreshIdentityCache",
        "summary": "Trigger identity cache refresh",
        "tags": ["Identities"],
        "responses": {
          "200": {"description": "Refresh triggered"},
          "403": {"description": "Insufficient permission"}
        }
      }
    },
    "/breakglass/invoke": {
      "post": {
        "operationId": "invokeBreakGlass",
        "summary": "Invoke break-glass access",
        "description": "Creates an immutable break-glass incident record and immediately executes the action, bypassing approval workflows.",
        "tags": ["Break-Glass"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action_key", "target_email", "reason"],
                "properties": {
                  "action_key": {"type": "string"},
                  "instance_id": {"type": "string", "format": "uuid"},
                  "target_email": {"type": "string", "format": "email"},
                  "reason": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Incident created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"incident_id": {"type": "string", "format": "uuid"}}
                }
              }
            }
          },
          "400": {"description": "Invalid request"},
          "403": {"description": "Insufficient permission"}
        }
      }
    },
    "/breakglass/incidents": {
      "get": {
        "operationId": "listIncidents",
        "summary": "List break-glass incidents",
        "tags": ["Break-Glass"],
        "responses": {
          "200": {"description": "Incidents list"}
        }
      }
    },
    "/breakglass/incidents/{id}/review": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "reviewIncident",
        "summary": "Submit a review note for an incident",
        "tags": ["Break-Glass"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"type": "object", "properties": {"note": {"type": "string"}}}
            }
          }
        },
        "responses": {
          "200": {"description": "Review recorded"},
          "403": {"description": "Insufficient permission"}
        }
      }
    },
    "/tokens": {
      "get": {
        "operationId": "listTokens",
        "summary": "List API tokens for the current user",
        "tags": ["Tokens"],
        "responses": {
          "200": {
            "description": "Token list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {"type": "array", "items": {"$ref": "#/components/schemas/Token"}}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createToken",
        "summary": "Create an API token",
        "tags": ["Tokens"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "scopes": {"type": "array", "items": {"type": "string"}},
                  "expires_in_days": {"type": "integer"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created — raw token only returned once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {"$ref": "#/components/schemas/Token"},
                    "raw": {"type": "string", "description": "Plain-text token value, shown once"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tokens/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "delete": {
        "operationId": "revokeToken",
        "summary": "Revoke an API token",
        "tags": ["Tokens"],
        "responses": {
          "200": {"description": "Token revoked"},
          "404": {"description": "Not found"}
        }
      }
    },
    "/admin/plugins": {
      "get": {
        "operationId": "listPlugins",
        "summary": "List installed integration plugins",
        "tags": ["Admin — Integrations"],
        "responses": {
          "200": {"description": "Plugin list"}
        }
      }
    },
    "/admin/instances": {
      "get": {
        "operationId": "listInstances",
        "summary": "List integration instances",
        "tags": ["Admin — Integrations"],
        "responses": {
          "200": {
            "description": "Instance list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instances": {"type": "array", "items": {"$ref": "#/components/schemas/Instance"}}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createInstance",
        "summary": "Create an integration instance",
        "tags": ["Admin — Integrations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "plugin_id"],
                "properties": {
                  "name": {"type": "string"},
                  "plugin_id": {"type": "string"},
                  "credentials": {"type": "object"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Instance created"},
          "400": {"description": "Invalid request"},
          "403": {"description": "Insufficient permission"}
        }
      }
    },
    "/admin/instances/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "put": {
